# ArcGPT-Backend — local configuration
#
# Copy to .env and set real local values. This file is the ONLY place backend
# secrets belong. Nothing here is ever exposed to the browser: the frontend is a
# static bundle and reads no server configuration.
#
# NEVER copy any of these values into a VITE_* variable in ../frontend. Those
# are inlined into the public bundle at build time.

# --- Local PostgreSQL -------------------------------------------------------
# The ArcGPT college ERP database. It is created by ../database/*.sql — see
# ../database/README.md for the build order.
#
# DB_NAME must point at THIS project's database. It must never be pointed at
# any other database on the server; those belong to other projects.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arcgpt_new

# Application (admin) pool: auth, sessions, conversations, query log, audit and
# CSV import. Created by database/11_permissions.sql. Run that file as a
# PostgreSQL superuser.
DB_USER=arcgpt_user
DB_PASSWORD=change-me-to-a-local-secret

# Read-only pool. THIS IS THE ONLY ROLE GENERATED SQL EVER RUNS AS. It holds
# SELECT on institution tables and views and no privilege at all on the ArcGPT
# control tables, so even a validator bypass cannot reach user credentials or
# the audit trail. A separate role is used rather than the pre-existing
# arcgpt_reader, which holds privileges in another project's database.
DB_READONLY_USER=arcgpt_new_reader
DB_READONLY_PASSWORD=change-me-to-a-local-secret

# --- Local AI engines --------------------------------------------------------
# ArcGPT can talk to two local inference servers. The provider below is used
# when the chat's model selector has not chosen one; Ollama is the default so a
# fresh install behaves exactly as it did before LM Studio was added.
#
#   LLM_PROVIDER=ollama     qwen2.5-coder:7b
#   LLM_PROVIDER=lmstudio   whatever LM Studio reports as loaded
#
# Choosing a model in the UI changes ONLY which model writes the SQL. The
# database, the read-only role, the SQL validator and the table allowlist are
# identical for every model.
LLM_PROVIDER=ollama

# Provider 1: Ollama.
OLLAMA_URL=http://127.0.0.1:11434
# Ollama models are named repo:tag. The Hugging Face style
# "qwen2.5-coder-7b-instruct" does not exist in the Ollama registry.
OLLAMA_MODEL=qwen2.5-coder:7b

# Provider 2: LM Studio. Start its local server from the Developer tab first
# (it listens on 1234 by default).
#
# The model id is DETECTED from GET {LMSTUDIO_BASE_URL}/models. It is never
# guessed, so no value here is required. Set LMSTUDIO_MODEL only to pin one
# specific model; if the running server does not report that exact id, ArcGPT
# reports the mismatch and uses a model it can actually see instead.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# The model id is DETECTED from GET {LMSTUDIO_BASE_URL}/models and never
# guessed, so no value here is required. Set LMSTUDIO_MODEL only to pin one
# specific model; if the running server does not report that exact id, ArcGPT
# reports the mismatch and uses a model it can actually see instead.
#
# Pin it when more than one model is loaded, which is the common case. Verified
# against a live LM Studio server serving Qwen3-Coder 30B A3B Instruct:
#   LMSTUDIO_MODEL=qwen3-coder-30b-a3b-instruct
LMSTUDIO_MODEL=

# Ceiling on a single model request. A 30B model on CPU can take minutes on a
# first prompt while its weights are still being loaded into memory.
# LLM_REQUEST_TIMEOUT_MS=180000

# How long the UI waits before a provider is reported as unreachable.
# OLLAMA_PROBE_TIMEOUT_MS=2000
# LMSTUDIO_PROBE_TIMEOUT_MS=3000

# --- Express server ---------------------------------------------------------
SERVER_PORT=3000
PORT=3000

# Used to sign/verify local session material.
SESSION_SECRET=change-me-to-a-long-random-value

# First-run bootstrap administrator. Created automatically on startup if it
# does not already exist. The password is bcrypt-hashed before insertion and is
# never returned to the browser. Remove these two lines once the account
# exists and you have set a real password for it.
LOCAL_ADMIN_EMAIL=admin@institution.edu
LOCAL_ADMIN_PASSWORD=AdminPassword123!

# --- Development auto-session -----------------------------------------------
# The ArcGPT chat screen has no login form, by design, but the API is
# session-gated. In development only, a request that arrives with no valid
# session cookie is given a session for the LOCAL_ADMIN account above, so the
# chat works on first load without changing the UI.
#
# This is IGNORED when NODE_ENV=production, where a real login is required.
# Set to false to disable it locally and exercise the login flow instead.
# LOCAL_AUTO_SESSION=true

# Comma-separated list of origins allowed to call this API with credentials.
# Only needed when the frontend is served from a different origin.
# APP_URL=http://localhost:3000
