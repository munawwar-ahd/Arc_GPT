# ArcGPT-Backend — local configuration
#
# Copy to .env and set real local values. This file is the ONLY place backend
# secrets belong. Nothing here is ever exposed to the browser: the frontend is a
# static bundle and reads no server configuration.
#
# NEVER copy any of these values into a VITE_* variable in ../frontend. Those
# are inlined into the public bundle at build time.

# --- Local PostgreSQL -------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arcgpt_institution
DB_USER=postgres
DB_PASSWORD=postgres

# Optional. A dedicated read-only role for query execution. The application uses
# DB_USER for migrations, auth, health checks and logging; when this is set,
# SELECT statements run as this role instead, which cannot be granted control
# table access by the migration. The role itself is created by the migration as
# NOLOGIN, so enable it once with:
#   ALTER ROLE arcgpt_reader LOGIN PASSWORD '<choose-a-local-value>';
# DB_READONLY_USER=arcgpt_reader
# DB_READONLY_PASSWORD=

# --- Local AI engine (Ollama) -----------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Express server ---------------------------------------------------------
SERVER_PORT=3000
PORT=3000

# Used to sign/verify local session material.
SESSION_SECRET=change-me-to-a-long-random-value

# First-run bootstrap administrator. Created automatically on startup if it
# does not already exist. The password is bcrypt-hashed before insertion and is
# never returned to the browser. Remove these two lines once the account
# exists and you have set a real password for it.
LOCAL_ADMIN_EMAIL=admin@institution.edu
LOCAL_ADMIN_PASSWORD=AdminPassword123!

# --- Development auto-session -----------------------------------------------
# The ArcGPT chat screen has no login form, by design, but the API is
# session-gated. In development only, a request that arrives with no valid
# session cookie is given a session for the LOCAL_ADMIN account above, so the
# chat works on first load without changing the UI.
#
# This is IGNORED when NODE_ENV=production, where a real login is required.
# Set to false to disable it locally and exercise the login flow instead.
# LOCAL_AUTO_SESSION=true

# Comma-separated list of origins allowed to call this API with credentials.
# Only needed when the frontend is served from a different origin.
# APP_URL=http://localhost:3000
